{
  "name": "gpu-marketplace-provider-agent",
  "version": "1.0.0",
  "description": "GPU Marketplace Provider Desktop Agent",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "npm run build:electron && node -e \"setTimeout(() => process.exit(0), 2000)\" && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build && electron-builder",
    "build:react": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run build:react && npm run build:electron",
    "package": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:win:unsigned": "npm run build:all && electron-builder --win portable --config.forceCodeSigning=false",
    "dist:mac": "npm run build:all && electron-builder --mac",
    "lint": "eslint src --ext ts,tsx",
    "preview": "vite preview"
  },
  "keywords": [
    "gpu",
    "marketplace",
    "provider",
    "blender",
    "rendering"
  ],
  "author": "GPU Marketplace",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vite": "^5.0.5",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gpumarketplace.provider-agent",
    "productName": "GPU Marketplace Provider",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/bin/blender",
        "to": "backend/bin/blender",
        "filter": ["**/*"]
      },
      {
        "from": "../build/bin/gpu_info.json",
        "to": "backend/bin/gpu_info.json"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
